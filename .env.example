SUPERMEMORY_API_KEY=sm_your_api_key
SUPERMEMORY_BASE_URL=https://api.supermemory.ai
# Optional. Overrides the configured default container tag.
SUPERMEMORY_CONTAINER_TAG=hermes-work
# Set MCP_TRANSPORT=http to serve Streamable HTTP for tunnel-client.
MCP_TRANSPORT=http
MCP_HOST=127.0.0.1
MCP_PORT=4589
